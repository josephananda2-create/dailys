# =============================================================================
# Morning Brief — environment variables
# Copy this file to `.env` and fill in what you have. EVERYTHING IS OPTIONAL.
# With nothing set, the app still runs an RSS-only brief in "raw" mode.
# Never commit the real .env file.
# =============================================================================

# --- Summarisation / insight extraction (Anthropic) --------------------------
# Without this, the brief is still generated but in extractive "raw" mode
# (headlines + snippets, no LLM rewriting or Strategist's Takeaway).
ANTHROPIC_API_KEY=
# Optional overrides:
BRIEF_MODEL=claude-sonnet-5
# ANTHROPIC_BASE_URL=

# --- Notion (storage: archive, saved insights, seen-story log) ---------------
# Create an internal integration at https://www.notion.so/my-integrations
# then SHARE your parent page with that integration.
NOTION_API_KEY=
# The page under which the app will create/find its databases.
# Copy the 32-char id from the page URL.
NOTION_PARENT_PAGE_ID=

# --- Google (Gmail scan + Calendar + optional email send) --------------------
# One OAuth client covers Gmail read, Calendar read, and Gmail send.
# See README "Google setup". Run `python scripts/google_auth.py` to mint the
# refresh token, then paste it here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- Delivery ----------------------------------------------------------------
# Where to email the brief.
BRIEF_RECIPIENT=josephananda2@gmail.com

# Simple email delivery via a Gmail App Password (recommended — no OAuth, no
# token expiry). Needs 2-Step Verification on the Google account, then generate
# a 16-char app password at https://myaccount.google.com/apppasswords
# If set, this is used instead of the Gmail API for sending.
SMTP_USER=josephananda2@gmail.com
SMTP_APP_PASSWORD=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# --- Optional: NewsAPI for the "news" connector (https://newsapi.org) ---------
NEWSAPI_KEY=

# --- Behaviour ---------------------------------------------------------------
TZ=Asia/Kuala_Lumpur
LOG_LEVEL=INFO
